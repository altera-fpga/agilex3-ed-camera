###################################################################################
# src/tcl/pins.qsf
###################################################################################

# -----------------------------------------------------------------------------
# Board clock / reset / push-buttons / LEDs
# -----------------------------------------------------------------------------

# clock/global reset
# (HVIO6C_PLLREFCLK1) SI5332A-GM1 OUT4, default to 100MHz
set_location_assignment PIN_AJ27                            -to clk_100_mhz
set_instance_assignment -name GLOBAL_SIGNAL ON              -to clk_100_mhz -entity top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS"    -to clk_100_mhz -entity top

# pin FPGA_CORE_RESETn, silkscreen=FPGA_RESET
set_location_assignment PIN_M1                              -to rst_pb_n
set_instance_assignment -name IO_STANDARD "1.1-V"           -to rst_pb_n -entity top

# push buttons and LEDs
set_location_assignment PIN_L1 -to user_pb_n[0] -comment FPGA_PB0
set_instance_assignment -name IO_STANDARD "1.1-V"           -to user_pb_n[0] -entity top

set_location_assignment PIN_K1                              -to user_led[0]
set_location_assignment PIN_L2                              -to user_led[1]
set_instance_assignment -name CURRENT_STRENGTH_NEW 12MA     -to user_led[0]
set_instance_assignment -name SLEW_RATE 0                   -to user_led[0]
set_instance_assignment -name IO_STANDARD "1.1 V"           -to user_led[0] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 12MA     -to user_led[1]
set_instance_assignment -name SLEW_RATE 0                   -to user_led[1]
set_instance_assignment -name IO_STANDARD "1.1 V"           -to user_led[1] -entity top

# -----------------------------------------------------------------------------
# EMIF/DDR4
# -----------------------------------------------------------------------------

set_location_assignment PIN_AF7 -to bank_2a_mem_ca[0]    -comment "EMIF 2A"
set_location_assignment PIN_AE7 -to bank_2a_mem_ca[1]    -comment "EMIF 2A"
set_location_assignment PIN_AF6 -to bank_2a_mem_ca[2]    -comment "EMIF 2A"
set_location_assignment PIN_AE6 -to bank_2a_mem_ca[3]    -comment "EMIF 2A"
set_location_assignment PIN_AH5 -to bank_2a_mem_ca[4]    -comment "EMIF 2A"
set_location_assignment PIN_AG5 -to bank_2a_mem_ca[5]    -comment "EMIF 2A"
set_location_assignment PIN_AB3 -to bank_2a_mem_ck[0]    -comment "EMIF 2A"
set_location_assignment PIN_AA4 -to bank_2a_mem_ck_n[0]  -comment "EMIF 2A"
set_location_assignment PIN_AH6 -to bank_2a_mem_cke[0]   -comment "EMIF 2A"
set_location_assignment PIN_AF4 -to bank_2a_mem_cs[0]    -comment "EMIF 2A"
set_location_assignment PIN_AD2 -to bank_2a_mem_dmi[0]   -comment "EMIF 2A"
set_location_assignment PIN_AJ5 -to bank_2a_mem_dmi[1]   -comment "EMIF 2A"
set_location_assignment PIN_T3  -to bank_2a_mem_dmi[2]   -comment "EMIF 2A"
set_location_assignment PIN_T6  -to bank_2a_mem_dmi[3]   -comment "EMIF 2A"
set_location_assignment PIN_AB1 -to bank_2a_mem_dq[0]    -comment "EMIF 2A"
set_location_assignment PIN_AJ7 -to bank_2a_mem_dq[10]   -comment "EMIF 2A"
set_location_assignment PIN_AJ8 -to bank_2a_mem_dq[11]   -comment "EMIF 2A"
set_location_assignment PIN_AG3 -to bank_2a_mem_dq[12]   -comment "EMIF 2A"
set_location_assignment PIN_AH2 -to bank_2a_mem_dq[13]   -comment "EMIF 2A"
set_location_assignment PIN_AH3 -to bank_2a_mem_dq[14]   -comment "EMIF 2A"
set_location_assignment PIN_AJ3 -to bank_2a_mem_dq[15]   -comment "EMIF 2A"
set_location_assignment PIN_P4  -to bank_2a_mem_dq[16]   -comment "EMIF 2A"
set_location_assignment PIN_P5  -to bank_2a_mem_dq[17]   -comment "EMIF 2A"
set_location_assignment PIN_U3  -to bank_2a_mem_dq[18]   -comment "EMIF 2A"
set_location_assignment PIN_V3  -to bank_2a_mem_dq[19]   -comment "EMIF 2A"
set_location_assignment PIN_AA2 -to bank_2a_mem_dq[1]    -comment "EMIF 2A"
set_location_assignment PIN_W3  -to bank_2a_mem_dq[20]   -comment "EMIF 2A"
set_location_assignment PIN_U4  -to bank_2a_mem_dq[21]   -comment "EMIF 2A"
set_location_assignment PIN_P3  -to bank_2a_mem_dq[22]   -comment "EMIF 2A"
set_location_assignment PIN_N3  -to bank_2a_mem_dq[23]   -comment "EMIF 2A"
set_location_assignment PIN_V5  -to bank_2a_mem_dq[24]   -comment "EMIF 2A"
set_location_assignment PIN_V6  -to bank_2a_mem_dq[25]   -comment "EMIF 2A"
set_location_assignment PIN_N7  -to bank_2a_mem_dq[26]   -comment "EMIF 2A"
set_location_assignment PIN_N6  -to bank_2a_mem_dq[27]   -comment "EMIF 2A"
set_location_assignment PIN_R7  -to bank_2a_mem_dq[28]   -comment "EMIF 2A"
set_location_assignment PIN_P7  -to bank_2a_mem_dq[29]   -comment "EMIF 2A"
set_location_assignment PIN_AA1 -to bank_2a_mem_dq[2]    -comment "EMIF 2A"
set_location_assignment PIN_W5  -to bank_2a_mem_dq[30]   -comment "EMIF 2A"
set_location_assignment PIN_U6  -to bank_2a_mem_dq[31]   -comment "EMIF 2A"
set_location_assignment PIN_Y2  -to bank_2a_mem_dq[3]    -comment "EMIF 2A"
set_location_assignment PIN_AG1 -to bank_2a_mem_dq[4]    -comment "EMIF 2A"
set_location_assignment PIN_AF2 -to bank_2a_mem_dq[5]    -comment "EMIF 2A"
set_location_assignment PIN_AF1 -to bank_2a_mem_dq[6]    -comment "EMIF 2A"
set_location_assignment PIN_AE2 -to bank_2a_mem_dq[7]    -comment "EMIF 2A"
set_location_assignment PIN_AK6 -to bank_2a_mem_dq[8]    -comment "EMIF 2A"
set_location_assignment PIN_AK7 -to bank_2a_mem_dq[9]    -comment "EMIF 2A"
set_location_assignment PIN_AC1 -to bank_2a_mem_dqs[0]   -comment "EMIF 2A"
set_location_assignment PIN_AK4 -to bank_2a_mem_dqs[1]   -comment "EMIF 2A"
set_location_assignment PIN_U5  -to bank_2a_mem_dqs[2]   -comment "EMIF 2A"
set_location_assignment PIN_R5  -to bank_2a_mem_dqs[3]   -comment "EMIF 2A"
set_location_assignment PIN_AC2 -to bank_2a_mem_dqs_n[0] -comment "EMIF 2A"
set_location_assignment PIN_AJ4 -to bank_2a_mem_dqs_n[1] -comment "EMIF 2A"
set_location_assignment PIN_T4  -to bank_2a_mem_dqs_n[2] -comment "EMIF 2A"
set_location_assignment PIN_R6  -to bank_2a_mem_dqs_n[3] -comment "EMIF 2A"
set_location_assignment PIN_AD4 -to bank_2a_mem_reset_n  -comment "EMIF 2A"
set_location_assignment PIN_AF3 -to bank_2a_mem_pll_ref_clk
set_location_assignment PIN_AD3 -to bank_2a_mem_oct_rzqin

set_instance_assignment -name IO_STANDARD "1.1V TRUE DIFFERENTIAL SIGNALING" -to bank_2a_mem_pll_ref_clk -entity top
set_instance_assignment -name IO_STANDARD "1.1V" -to bank_2a_mem_oct_rzqin -entity top

# -----------------------------------------------------------------------------
# MIPI CSI-2 RX (camera input)
# -----------------------------------------------------------------------------

# CSI RX is on bank 3A (same as the 4k-isp-lite-ed design) so that the EMIF
# has bank 2A to itself.

set_location_assignment PIN_F2 -to mipi_csi2_rx_dphy_ref_clk -comment IOBANK_3A_T
set_location_assignment PIN_G1 -to mipi_csi2_rx_dphy_rzq -comment IOBANK_3A_T

set_location_assignment PIN_D5 -to mipi_csi2_rx_dphy_link0_io_c_p -comment IOBANK_3A_T
set_location_assignment PIN_E5 -to mipi_csi2_rx_dphy_link0_io_c_n -comment IOBANK_3A_T
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_c_p -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_c_n -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_c_p -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_c_n -entity top

set_location_assignment PIN_C5 -to mipi_csi2_rx_dphy_link0_io_d_p[0]
set_location_assignment PIN_D4 -to mipi_csi2_rx_dphy_link0_io_d_n[0]
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_d_p[0] -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_d_n[0] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_d_p[0] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_d_n[0] -entity top

set_location_assignment PIN_F6 -to mipi_csi2_rx_dphy_link0_io_d_p[1]
set_location_assignment PIN_E6 -to mipi_csi2_rx_dphy_link0_io_d_n[1]
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_d_p[1] -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_csi2_rx_dphy_link0_io_d_n[1] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_d_p[1] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_csi2_rx_dphy_link0_io_d_n[1] -entity top

set_location_assignment PIN_AF27 -to mipi_csi2_rx_power_en -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_csi2_rx_power_en -entity top

set_location_assignment PIN_AJ28 -to mipi_csi2_rx_led_en -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_csi2_rx_led_en -entity top

set_location_assignment PIN_AK21 -to mipi_csi2_rx_i2c_scl -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_csi2_rx_i2c_scl -entity top

set_location_assignment PIN_AK27 -to mipi_csi2_rx_i2c_sda -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_csi2_rx_i2c_sda -entity top

# -----------------------------------------------------------------------------
# MIPI DSI-2 TX (display output)
# -----------------------------------------------------------------------------

# DSI TX is on bank 2A (MIPI_CONN_2A = MIPI_CONN_1). Schematic names:
#
# AC7  RZQ_T_2A_R
# AC6  MIPI_2A_REFCLK_P
# AC5  MIPI_2A_REFCLK_N
# T2   MIPI_CONN_2A_CAM_CK_P
# U1   MIPI_CONN_2A_CAM_CK_N
# Y1   MIPI_CONN_2A_CAM_D0_P
# W2   MIPI_CONN_2A_CAM_D0_N
# V1   MIPI_CONN_2A_CAM_D1_P
# V2   MIPI_CONN_2A_CAM_D1_N
# R2   MIPI_CONN_2A_CAM_D2_P
# T1   MIPI_CONN_2A_CAM_D2_N
# R1   MIPI_CONN_2A_CAM_D3_P
# P2   MIPI_CONN_2A_CAM_D3_N
# AH28 MIPI_CONN_1_SCL
# AK20 MIPI_CONN_1_SDA
# AJ29 POWER_EN_MIPI_CONN_1
# AK26 LED_EN_MIPI_CONN_1

set_location_assignment PIN_AC6 -to mipi_dsi2_tx_dphy_ref_clk -comment IOBANK_2A_T
set_instance_assignment -name IO_STANDARD "1.1V TRUE DIFFERENTIAL SIGNALING" -to mipi_dsi2_tx_dphy_ref_clk -entity top
set_instance_assignment -name IO_STANDARD "1.1V TRUE DIFFERENTIAL SIGNALING" -to mipi_dsi2_tx_dphy_ref_clk(n) -entity top
set_location_assignment PIN_AC7 -to mipi_dsi2_tx_dphy_rzq -comment IOBANK_2A_T
#set_instance_assignment -name IO_STANDARD "1.1 V" -to mipi_dsi2_tx_dphy_rzq -entity top

set_location_assignment PIN_T2 -to mipi_dsi2_tx_dphy_link0_io_c_p -comment IOBANK_2A_T
set_location_assignment PIN_U1 -to mipi_dsi2_tx_dphy_link0_io_c_n -comment IOBANK_2A_T
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_c_p -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_c_n -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_c_p -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_c_n -entity top

set_location_assignment PIN_Y1 -to mipi_dsi2_tx_dphy_link0_io_d_p[0] -comment IOBANK_2A_T
set_location_assignment PIN_W2 -to mipi_dsi2_tx_dphy_link0_io_d_n[0] -comment IOBANK_2A_T
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_d_p[0] -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_d_n[0] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_d_p[0] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_d_n[0] -entity top

set_location_assignment PIN_V1 -to mipi_dsi2_tx_dphy_link0_io_d_p[1] -comment IOBANK_2A_T
set_location_assignment PIN_V2 -to mipi_dsi2_tx_dphy_link0_io_d_n[1] -comment IOBANK_2A_T
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_d_p[1] -entity top
set_instance_assignment -name IO_STANDARD DPHY -to mipi_dsi2_tx_dphy_link0_io_d_n[1] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_d_p[1] -entity top
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to mipi_dsi2_tx_dphy_link0_io_d_n[1] -entity top

