set_location_assignment PIN_AH28 -to mipi_dsi2_tx_i2c_scl -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_dsi2_tx_i2c_scl -entity top
set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to mipi_dsi2_tx_i2c_scl -entity top

set_location_assignment PIN_AK20 -to mipi_dsi2_tx_i2c_sda -comment IOBANK_5B
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to mipi_dsi2_tx_i2c_sda -entity top
set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to mipi_dsi2_tx_i2c_sda -entity top

# -----------------------------------------------------------------------------
# DisplayPort TX
# -----------------------------------------------------------------------------

set_location_assignment PIN_P25 -to fgt_refclk_150
set_instance_assignment -name IO_STANDARD "CURRENT MODE LOGIC (CML)" -to fgt_refclk_150 -entity top

set_location_assignment PIN_K27 -to pin_dp_tx_p[0]
set_location_assignment PIN_G27 -to pin_dp_tx_p[1]

set_location_assignment PIN_J27 -to pin_dp_tx_n[0]
set_location_assignment PIN_F27 -to pin_dp_tx_n[1]

set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pin_dp_tx_p[0] -entity top
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pin_dp_tx_p[1] -entity top
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pin_dp_tx_n[0] -entity top
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pin_dp_tx_n[1] -entity top

set_location_assignment PIN_Y6  -to pin_dp_tx_hpd
set_location_assignment PIN_J2  -to pin_dp_tx_aux_in
set_location_assignment PIN_W7  -to pin_dp_tx_cad
set_location_assignment PIN_H2  -to pin_dp_tx_aux_out
set_location_assignment PIN_AB5 -to pin_dp_tx_aux_oe

set_instance_assignment -name IO_STANDARD "1.1-V" -to pin_dp_tx_hpd -entity top
set_instance_assignment -name IO_STANDARD "1.1-V" -to pin_dp_tx_aux_in -entity top
set_instance_assignment -name IO_STANDARD "1.1-V" -to pin_dp_tx_cad -entity top
set_instance_assignment -name IO_STANDARD "1.1-V" -to pin_dp_tx_aux_out -entity top
set_instance_assignment -name IO_STANDARD "1.1-V" -to pin_dp_tx_aux_oe -entity top

